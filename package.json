{
  "name": "derohost",
  "version": "1.0.0",
  "description": "DeroHost - Production-Ready Minecraft Hosting Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm --workspace=@derohost/api dev",
    "dev:web": "npm --workspace=@derohost/web dev",
    "dev:agent": "npm --workspace=@derohost/agent dev",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:agent\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "prisma:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "install:scripts": "prisma generate --schema packages/db/prisma/schema.prisma",
    "start": "npm run prisma:generate && npm run dev:web",
    "postinstall": "npm run prisma:generate 2>/dev/null; exit 0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "prisma": "^5.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
